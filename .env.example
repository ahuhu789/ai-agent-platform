# =====================================================================
# AI Agent Platform (FME) - Cấu hình Môi trường Mẫu (.env.example)
# =====================================================================

# 1. Cấu hình LLM Provider (LLMFactory)
# Hỗ trợ: groq, openai, ollama, huggingface, mock
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_groq_or_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_TIMEOUT=30

# HuggingFace (nếu dùng provider huggingface)
# HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# 2. Cấu hình Memory & Cache
# Hỗ trợ provider: in_memory hoặc redis
MEMORY_PROVIDER=in_memory
REDIS_URL=redis://localhost:6379/0

# 3. Cấu hình MCP Servers (stdio hoặc sse)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001

# 4. Cấu hình Backend API thật cho từng phân hệ (nếu kết nối production API)
# Nếu để trống, các MCP Server sẽ tự động dùng Mock Data có sẵn
# HIRING_API_BASE_URL=https://api.fme.internal/v1/hiring
# HIRING_API_KEY=your_hiring_token_here

# ATTENDANCE_API_URL=https://api.fme.internal/v1/attendance
# ATTENDANCE_API_TOKEN=your_attendance_token_here

# EMPLOYEE_API_URL=https://api.fme.internal/v1/employee
# EMPLOYEE_API_TOKEN=your_employee_token_here

# 5. Cấu hình Chat API (FastAPI)
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
