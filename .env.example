# =====================================================================
# Cấu hình Phân hệ Tuyển dụng (Hiring Subsystem - FME)
# =====================================================================

# 1. Cấu hình LLM Provider (Tùy chọn: Groq, OpenAI, DeepSeek, v.v.)
# Nếu không cung cấp API key, Agent sẽ tự động chạy chế độ Rule-based offline
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# 2. Cấu hình REST API Backend Tuyển dụng (FME)
# Nếu để trống, MCP Server sẽ sử dụng Mock Data chuẩn có sẵn
# HIRING_API_BASE_URL=https://api.fme.internal/v1/hiring
# HIRING_API_KEY=your_backend_api_token_here

# 3. Cấu hình MCP Server Transport
MCP_TRANSPORT=stdio
MCP_PORT=8001
MCP_HOST=0.0.0.0
